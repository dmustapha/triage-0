[Unit]
Description=llama.cpp server (fallback backend for Triage-0)
After=network-online.target

[Service]
User=triage0
Group=triage0
EnvironmentFile=-/etc/triage0.env
ExecStart=/bin/sh -c 'exec /opt/llama.cpp/build/bin/llama-server -m /opt/triage0/models/${LLAMA_MODEL_FILE:-medpsy-4b-q4_k_m-imat.gguf} --host 127.0.0.1 --port 8081 -c 2048 -t "$(nproc)" --jinja --reasoning-budget 0'
Restart=on-failure
RestartSec=5
MemoryMax=80%
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
